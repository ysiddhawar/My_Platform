# My_Platform Environment Configuration
# Copy this file to .env and fill in the values

# ============================================
# Application Settings
# ============================================

# Application environment: development, staging, production
APP_ENV=development

# Application debug mode
DEBUG=true

# Application secret key for session encryption
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# Database Configuration
# ============================================

# SQLite database paths (default paths used in code)
# CONFIG_DB_PATH=config_store.db
# API_CONFIG_DB_PATH=api_config_store.db
# TRADE_DB_PATH=trades.db
# ACCOUNT_DB_PATH=accounts.db
# USER_DB_PATH=api_user_store.db
# SESSION_DB_PATH=api_session_store.db

# For production, you might want to use PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/my_platform

# ============================================
# API Server Configuration
# ============================================

# API server host and port
API_HOST=0.0.0.0
API_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Frontend Configuration
# ============================================

# Next.js frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Frontend port
FRONTEND_PORT=3000

# ============================================
# Authentication & Security
# ============================================

# JWT secret for token generation (if implemented)
JWT_SECRET=your-jwt-secret-here-change-in-production

# Token expiration time in seconds
TOKEN_EXPIRY=86400

# ============================================
# Monitoring & Observability
# ============================================

# Enable detailed logging
ENABLE_DETAILED_LOGGING=true

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============================================
# Execution Engine Configuration
# ============================================

# Execution engine fail-fast mode
EXECUTION_FAIL_FAST=false

# Maximum concurrent executions
MAX_CONCURRENT_EXECUTIONS=10

# ============================================
# Risk Modeling Configuration
# ============================================

# Default random seed for simulations
DEFAULT_RANDOM_SEED=42

# Default number of periods for simulations
DEFAULT_SIMULATION_PERIODS=300

# ============================================
# External Services (if integrated)
# ============================================

# Broker API key (if integrating with trading platforms)
# BROKER_API_KEY=your-broker-api-key

# Broker API secret (if integrating with trading platforms)
# BROKER_API_SECRET=your-broker-api-secret

# Data provider API key (if using external market data)
# DATA_PROVIDER_API_KEY=your-data-provider-key

# ============================================
# Email/SMTP Configuration (if needed)
# ============================================

# SMTP server for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-email-password
# EMAIL_FROM=noreply@myplatform.com

# ============================================
# File Storage Configuration
# ============================================

# Maximum upload size in bytes
MAX_UPLOAD_SIZE=10485760  # 10MB

# Temporary file directory
TEMP_DIR=/tmp/my_platform

# ============================================
# Rate Limiting
# ============================================

# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Requests per minute
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================
# Cache Configuration
# ============================================

# Enable caching
ENABLE_CACHING=true

# Cache timeout in seconds
CACHE_TIMEOUT=300

# ============================================
# Feature Flags
# ============================================

# Enable AI diagnostic features
ENABLE_AI_DIAGNOSTICS=true

# Enable risk modeling features
ENABLE_RISK_MODELING=true

# Enable execution tools
ENABLE_EXECUTION_TOOLS=true

# Enable monitoring dashboard
ENABLE_MONITORING_DASHBOARD=true